{
  "name": "eslint-plugin-galaxy",
  "version": "2.1.0",
  "description": "Various ESLint rules in one plugin.",
  "type": "module",
  "main": "./dist/index.js",
  "files": [
    "dist",
    "docs"
  ],
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "lint": "eslint --fix './**/*.{js,mjs,ts}'",
    "lint:ci": "eslint --max-warnings 0 './**/*.{js,mjs,ts}'",
    "prepack": "tsdown",
    "release": "release-it",
    "test": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CyanSalt/eslint-plugin-galaxy.git"
  },
  "bugs": {
    "url": "https://github.com/CyanSalt/eslint-plugin-galaxy/issues"
  },
  "homepage": "https://github.com/CyanSalt/eslint-plugin-galaxy#readme",
  "keywords": [
    "eslint",
    "eslintplugin"
  ],
  "author": "CyanSalt",
  "license": "ISC",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.15.0",
      "onFail": "error"
    },
    "packageManager": [
      {
        "name": "pnpm",
        "version": "^11.0.0",
        "onFail": "ignore"
      },
      {
        "name": "npm",
        "onFail": "ignore"
      }
    ]
  },
  "dependencies": {
    "@typescript-eslint/utils": "^8.59.0",
    "browserslist": "^4.28.2",
    "caniuse-lite": "^1.0.30001826",
    "esquery": "^1.7.0",
    "globals": "^17.14.0",
    "ignore": "^7.0.14",
    "micromatch": "^4.0.8"
  },
  "devDependencies": {
    "@cyansalt/eslint-config": "^4.6.0",
    "@cyansalt/tsconfig": "^3.0.2",
    "@release-it/conventional-changelog": "^12.0.2",
    "@types/esquery": "^1.5.4",
    "@types/micromatch": "^4.0.10",
    "@types/node": "^24.12.3",
    "@typescript-eslint/parser": "^8.59.0",
    "@typescript-eslint/rule-tester": "^8.59.0",
    "eslint": "^10.2.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-vue": "^10.8.0",
    "eslint-plugin-vue-scoped-css": "^3.0.0",
    "release-it": "^21.1.2",
    "tsdown": "^0.23.7",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "vue-eslint-parser": "^10.4.2"
  },
  "peerDependencies": {
    "eslint": ">=8.44.0",
    "eslint-plugin-import-x": ">=4.18.0",
    "eslint-plugin-vue": ">=9.19.0",
    "eslint-plugin-vue-scoped-css": ">=2.6.0"
  },
  "peerDependenciesMeta": {
    "eslint-plugin-import": {
      "optional": true
    },
    "eslint-plugin-import-x": {
      "optional": true
    },
    "eslint-plugin-vue": {
      "optional": true
    },
    "eslint-plugin-vue-scoped-css": {
      "optional": true
    }
  }
}
